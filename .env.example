# 필수 — 없으면 프로세스 시작 실패. 메인 Postgres의 blog DB, 앱 전용 롤 blog_app(db/blog_app_role.sql).
# 서버에만 둔다. 브라우저·클라이언트 번들에 노출 금지.
DATABASE_URL=postgresql://blog_app:<비밀번호>@<호스트>:5432/blog

# 선택 — 쓰기·draft 조회용 관리자 키. 예: openssl rand -hex 32
BLOG_API_KEY=

# 조회수 방문자 해싱 키. 비우면 조회를 기록하지 않는다(counted=false).
# 예전에 비워 두고 SUPABASE_SECRET_KEY로 대체되던 환경은 그 값을 그대로 옮겨야 같은 날 중복 제거가 이어진다.
VIEW_HASH_SALT=

# 테스트 — DB 테스트용. 관리자 접속(스키마 비우기)과 앱 접속(blog_app 권장).
TEST_DATABASE_URL=
TEST_APP_DATABASE_URL=
